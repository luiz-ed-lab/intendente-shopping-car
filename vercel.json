{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[...path].js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/importar", "schedule": "0 9 * * *" }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "comment": "as rotas do site caem em index.html por rewrite; sem isso a borda da Vercel guarda o HTML antigo e o deploy novo demora a aparecer",
      "source": "/((?!api/|.*\\.(?:png|jpg|jpeg|gif|svg|ico|webp|js|css|txt|xml)$).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
