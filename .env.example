# Nomes das variáveis que a API usa. Os valores reais ficam só na Vercel
# (Project Settings > Environment Variables). Nunca coloque valores reais aqui.

DATABASE_URL=        # conexão do Postgres no Neon
PAINEL_TOKEN=        # senha do painel e das rotas protegidas (também é secret no GitHub Actions)
RESEND_API_KEY=      # envio dos e-mails de lead
RESEND_FROM=         # remetente dos e-mails
ACEIMA_EMAIL=        # quem recebe a cópia dos leads
SITE_URL=            # endereço público do site
GOOGLE_PLACES_KEY=   # chave da API do Google (Places API New): avaliações reais das lojas na faixa da home
GITHUB_TOKEN=        # token do GitHub com escrita em Contents deste repositório: o modo de edição (/?editar) grava conteudo.js
